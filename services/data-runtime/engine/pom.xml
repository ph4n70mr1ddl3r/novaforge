<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.novaforge</groupId>
    <artifactId>novaforge-data-runtime-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>novaforge-data-runtime-engine</artifactId>
  <name>NovaForge Data Runtime :: engine</name>
  <description>Write/query orchestration (PHASE-1 §5): metadata resolution + version-keyed
    cache, defaults + sequence binding, field validations, inline children, optimistic
    locking, idempotency, query/aggregate/batch, the DomainEventPublisher seam.</description>

  <dependencies>
    <dependency>
      <groupId>com.novaforge</groupId>
      <artifactId>novaforge-common-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.novaforge</groupId>
      <artifactId>novaforge-metadata-model</artifactId>
    </dependency>
    <dependency>
      <groupId>com.novaforge</groupId>
      <artifactId>novaforge-security-context</artifactId>
    </dependency>
    <dependency>
      <groupId>com.novaforge</groupId>
      <artifactId>novaforge-expression-dsl</artifactId>
    </dependency>
    <dependency>
      <groupId>com.novaforge</groupId>
      <artifactId>novaforge-data-runtime-storage</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.novaforge</groupId>
      <artifactId>novaforge-data-runtime-authorization</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-kafka</artifactId>
    </dependency>
    <!-- Hook-kind telemetry (PHASE-3 §6): flow vs script executions per app — the
         script-ratio KPI's join side. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.novaforge</groupId>
      <artifactId>novaforge-test-support</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
