exports[`resolveDefaultPage goldens (L1, §5) > form default: field-type widget mapping + roll-up/formula readonly + related lists 1`] = `
{
  "apiName": "orderForm",
  "entity": "Order",
  "model": {
    "actions": [
      {
        "type": "save",
      },
      {
        "type": "cancel",
      },
    ],
    "base": "auto",
    "kind": "form",
    "root": {
      "children": [
        {
          "bind": "reference",
          "key": "field:reference",
          "props": {
            "field": "reference",
            "label": "reference",
          },
          "required": "true",
          "type": "novaforge.field-input",
        },
        {
          "bind": "status",
          "key": "field:status",
          "props": {
            "field": "status",
            "label": "status",
            "options": [
              "DRAFT",
              "POSTED",
            ],
          },
          "type": "novaforge.field-select",
        },
        {
          "bind": "total",
          "key": "field:total",
          "props": {
            "currency": "EUR",
            "field": "total",
            "label": "total",
          },
          "readonly": "true",
          "type": "novaforge.field-number",
        },
        {
          "bind": "customer",
          "key": "field:customer",
          "props": {
            "field": "customer",
            "label": "customer",
            "minChars": 2,
            "target": "Customer",
          },
          "type": "novaforge.field-lookup",
        },
        {
          "bind": "memo",
          "key": "field:memo",
          "props": {
            "field": "memo",
            "label": "memo",
            "multiline": true,
          },
          "type": "novaforge.field-input",
        },
        {
          "bind": "createdAt",
          "key": "field:createdAt",
          "props": {
            "field": "createdAt",
            "label": "createdAt",
            "mode": "datetime",
          },
          "type": "novaforge.field-date",
        },
        {
          "bind": "tags",
          "key": "field:tags",
          "props": {
            "field": "tags",
            "label": "tags",
          },
          "readonly": "true",
          "type": "novaforge.field-json",
        },
        {
          "bind": "lines",
          "key": "related:lines",
          "props": {
            "pageSize": 50,
            "relationship": "lines",
            "target": "OrderLine",
          },
          "type": "novaforge.related-list",
        },
      ],
      "key": "form",
      "props": {
        "columns": 2,
        "title": "Sales Order",
      },
      "type": "novaforge.form-layout",
    },
  },
  "type": "form",
}
`;
