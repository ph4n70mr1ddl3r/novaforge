<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.novaforge</groupId>
    <artifactId>novaforge-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../../pom.xml</relativePath>
  </parent>

  <artifactId>novaforge-metadata-model</artifactId>
  <name>NovaForge Metadata Model</name>
  <description>Definition POJOs + JSON Schema v0 for app/entity/field/relationship/page
    definitions and app-scoped settings (PHASE-1 §3).</description>

  <dependencies>
    <dependency>
      <groupId>com.novaforge</groupId>
      <artifactId>novaforge-common-core</artifactId>
    </dependency>
    <!-- expr/v1 — the shared expression grammar; the model's promotion-aware field
         resolver feeds the SQL lowering (PHASE-5 §3) shared by the publish-time
         compile gate and the Data Runtime's aggregate pipeline. -->
    <dependency>
      <groupId>com.novaforge</groupId>
      <artifactId>novaforge-expression-dsl</artifactId>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- Jackson 3 keeps the Jackson 2 annotations artifact (jackson-databind 3.1.4 pom). -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
