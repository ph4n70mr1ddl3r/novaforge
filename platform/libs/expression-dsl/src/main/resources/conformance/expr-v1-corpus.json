{
  "version": "expr/v1",
  "description": "Conformance corpus shared by the JVM and TS expression engines (PHASE-2 §7 Annex A): additions ship fixtures first. Dates/instants are tagged; numbers compare as exact decimals.",
  "cases": [
    { "name": "string equality", "expr": "status == 'POSTED'", "bindings": { "status": "POSTED" }, "expect": true },
    { "name": "string inequality", "expr": "status != 'VOID'", "bindings": { "status": "POSTED" }, "expect": true },
    { "name": "null-aware equality", "expr": "memo == null", "bindings": { "status": "DRAFT" }, "expect": true },
    { "name": "null != value", "expr": "memo != null", "bindings": { "memo": "x" }, "expect": true },
    { "name": "ordered comparison with null is false", "expr": "amount > 100", "bindings": { "amount": null }, "expect": false },
    { "name": "numeric comparison exact decimals", "expr": "amount >= 50.00", "bindings": { "amount": 50.0000 }, "expect": true },
    { "name": "logical and null predicate is false", "expr": "a && b", "bindings": { "a": true, "b": null }, "expect": false },
    { "name": "logical or short-circuit", "expr": "a || b", "bindings": { "a": true, "b": false }, "expect": true },
    { "name": "negation", "expr": "!cancelled", "bindings": { "cancelled": false }, "expect": true },
    { "name": "arithmetic exact", "expr": "quantity * 1.10", "bindings": { "quantity": 3 }, "expect": 3.3 },
    { "name": "arithmetic subtraction", "expr": "total - discount", "bindings": { "total": 100.00, "discount": 27.50 }, "expect": 72.50 },
    { "name": "division exact scale", "expr": "total / 4", "bindings": { "total": 100.00 }, "expect": 25 },
    { "name": "date minus date is days", "expr": "date('2026-08-21') - date('2026-08-16')", "bindings": {}, "expect": 5 },
    { "name": "date plus integer", "expr": "dueDate + 30", "bindings": { "dueDate": { "$date": "2026-08-01" } }, "expect": { "$date": "2026-08-31" } },
    { "name": "date minus integer", "expr": "dueDate - 30", "bindings": { "dueDate": { "$date": "2026-08-31" } }, "expect": { "$date": "2026-08-01" } },
    { "name": "membership", "expr": "status in ('A','B')", "bindings": { "status": "B" }, "expect": true },
    { "name": "membership miss", "expr": "status in ('A','B')", "bindings": { "status": "C" }, "expect": false },
    { "name": "balanced validation", "expr": "totalDebit == totalCredit && status != 'VOID'", "bindings": { "totalDebit": 10.5, "totalCredit": 10.5000, "status": "DRAFT" }, "expect": true },
    { "name": "today from injected clock", "expr": "today()", "bindings": {}, "clock": "2026-08-21T10:15:00Z", "expect": { "$date": "2026-08-21" } },
    { "name": "now from injected clock", "expr": "now()", "bindings": {}, "clock": "2026-08-21T10:15:30.500Z", "expect": { "$instant": "2026-08-21T10:15:30.500Z" } },
    { "name": "size of collection binding", "expr": "size(lines)", "bindings": { "lines": [1, 2, 3] }, "expect": 3 },
    { "name": "method form size", "expr": "lines.size()", "bindings": { "lines": ["a", "b"] }, "expect": 2 },
    { "name": "abs", "expr": "abs(delta)", "bindings": { "delta": -12.5 }, "expect": 12.5 },
    { "name": "round banker's", "expr": "round(x, 1)", "bindings": { "x": 2.25 }, "expect": 2.2 },
    { "name": "round to a negative scale (hundreds, banker's)", "expr": "round(1250, -2)", "expect": 1200 },
    { "name": "round negative HALF_EVEN tie", "expr": "round(x, 2)", "bindings": { "x": -2.375 }, "expect": -2.38 },
    { "name": "eval: non-integer round scale rejects", "expr": "round(total, 1.5)", "bindings": { "total": 50.0 }, "invalid": true },
    { "name": "min", "expr": "min(a, b)", "bindings": { "a": 3.5, "b": 2.5 }, "expect": 2.5 },
    { "name": "max", "expr": "max(a, b)", "bindings": { "a": 3.5, "b": 2.5 }, "expect": 3.5 },
    { "name": "string functions", "expr": "upper(trim(code)) == 'JE-1' && contains(code, '-') && startsWith(upper(trim(code)), 'JE') && length(trim(code)) == 4", "bindings": { "code": " je-1 " }, "expect": true },
    { "name": "lower", "expr": "lower(status)", "bindings": { "status": "POSTED" }, "expect": "posted" },
    { "name": "relationship path", "expr": "customer.region.code == 'EU'", "bindings": { "customer": { "region": { "code": "EU" } } }, "expect": true },
    { "name": "unary minus on reference", "expr": "-amount < 0", "bindings": { "amount": 5 }, "expect": true },
    { "name": "parenthesized grouping", "expr": "(a + b) * 2 == 10", "bindings": { "a": 2, "b": 3 }, "expect": true },
    { "name": "compile: unresolved reference rejected", "expr": "nope > 1", "invalid": true, "policy": { "bindings": ["amount"] } },
    { "name": "compile: clock banned in formula slots", "expr": "today() - entryDate > 30", "invalid": true, "policy": { "bindings": ["entryDate"], "allowClock": false } },
    { "name": "compile: clock allowed in validations", "expr": "today() - entryDate > 30", "policy": { "bindings": ["entryDate"], "allowClock": true }, "bindings": { "entryDate": { "$date": "2026-07-01" } }, "clock": "2026-08-21T00:00:00Z", "expect": true },
    { "name": "parse: bitwise rejected", "expr": "a & b", "invalid": true },
    { "name": "parse: unknown function rejected", "expr": "regexp(status, 'x')", "invalid": true },
    { "name": "parse: unterminated string", "expr": "status == 'OPEN", "invalid": true },
    { "name": "parse: template interpolation is not the scalar grammar", "expr": "${record.id} == 'x'", "invalid": true },
    { "name": "eval: division by zero", "expr": "total / zero", "bindings": { "total": 10, "zero": 0 }, "invalid": true },
    { "name": "static: text plus rejects (Annex A arithmetic)", "expr": "name + ' suffix'", "types": { "name": "text" }, "invalid": true },
    { "name": "static: boolean arithmetic rejects", "expr": "flag + 1", "types": { "flag": "boolean" }, "invalid": true },
    { "name": "static: date plus date rejects", "expr": "dueDate + shipDate", "types": { "dueDate": "date", "shipDate": "date" }, "invalid": true },
    { "name": "static: numeric on the left of a date rejects", "expr": "days + dueDate", "types": { "days": "numeric", "dueDate": "date" }, "invalid": true },
    { "name": "static: multiplication over text rejects", "expr": "label * 2", "types": { "label": "text" }, "invalid": true },
    { "name": "static: unary minus over text rejects", "expr": "-label < 0", "types": { "label": "text" }, "invalid": true },
    { "name": "static: logical over numeric rejects", "expr": "amount && flag", "types": { "amount": "numeric", "flag": "boolean" }, "invalid": true },
    { "name": "static: unknown method rejects", "expr": "name.upper()", "types": { "name": "text" }, "invalid": true },
    { "name": "static: wrong arity rejects", "expr": "round(x)", "types": { "x": "numeric" }, "invalid": true },
    { "name": "static: numeric arithmetic passes and evaluates", "expr": "qty * 1.10", "types": { "qty": "numeric" }, "bindings": { "qty": 3 }, "expect": 3.3 },
    { "name": "static: date arithmetic passes", "expr": "dueDate - 30", "types": { "dueDate": "date" }, "bindings": { "dueDate": { "$date": "2026-08-31" } }, "expect": { "$date": "2026-08-01" } },
    { "name": "static: unknown-typed operand stays fail-open", "expr": "mystery + 1", "types": {}, "bindings": { "mystery": 2 }, "expect": 3 },
    { "name": "static: text comparisons pass (no arithmetic involved)", "expr": "upper(status) == 'POSTED'", "types": { "status": "text" }, "bindings": { "status": "posted" }, "expect": true },
    { "name": "static: null-aware comparison passes (the null literal is not typed)", "expr": "memo == null", "types": { "memo": "text" }, "bindings": {}, "expect": true }
  ]
}
