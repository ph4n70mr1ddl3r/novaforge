<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.novaforge</groupId>
    <artifactId>novaforge-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../../pom.xml</relativePath>
  </parent>

  <artifactId>novaforge-security-context</artifactId>
  <name>NovaForge Security Context</name>
  <description>Tenant/actor propagation on top of TenantContext: async-executor
    decoration, the RLS session-var DataSource bridge, Kafka header constants,
    the shared trusted-service gate and service-token client, mock-test fixtures
    (PHASE-1 §3).</description>

  <dependencies>
    <dependency>
      <groupId>com.novaforge</groupId>
      <artifactId>novaforge-common-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-core</artifactId>
    </dependency>
    <!-- ServiceClientGate reads the resource-server JwtAuthenticationToken —
         versions ride Boot's dependencyManagement; every consuming service
         already carries them via its oauth2-resource-server starter. -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-oauth2-jose</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-oauth2-resource-server</artifactId>
    </dependency>
    <!-- ServiceTokenClient speaks the client-credentials grant over the JDK's
         plain HttpClient through the library auto-configuration (spring-context +
         Boot's autoconfigure; Jackson 3 parses the grant body the way metadata-model
         already does in-lib) — versions ride Boot's dependencyManagement, the
         autoconfigure dependency stays optional library style, and spring-web stays
         out entirely (the lib family's zero-web charter, PHASE-0 §5.1). -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
