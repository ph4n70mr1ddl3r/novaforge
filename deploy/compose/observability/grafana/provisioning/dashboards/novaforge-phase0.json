      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Availability (up)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "up{job=\"novaforge-gateway\"}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 1
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP server requests p95 (s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=\"novaforge-gateway\"}[5m])) by (le))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 9,
        "x": 6,
        "y": 1
      }
    },
