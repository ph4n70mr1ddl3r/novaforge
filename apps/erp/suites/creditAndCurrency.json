{
  "apiName": "creditAndCurrency",
  "label": "AR/AP allocation legs, multi-currency posting, dunning letters, AP subledger (PHASE-7 §2 AR/AP + Settings rows, §9 item 6 leg 1)",
  "cases": [
    {
      "name": "credit-note-allocates-against-invoice",
      "fixtures": [
        {
          "entity": "Account",
          "asRole": "accountingManager",
          "template": {
            "code": "1100",
            "name": "Accounts Receivable",
            "type": "ASSET"
          }
        },
        {
          "entity": "Account",
          "asRole": "accountingManager",
          "template": {
            "code": "4000",
            "name": "Sales Revenue",
            "type": "REVENUE"
          }
        },
        {
          "entity": "Customer",
          "asRole": "arClerk",
          "template": {
            "name": "Acme Corp"
          }
        }
      ],
      "steps": [
        {
          "op": "createRecord",
          "entity": "Invoice",
          "asRole": "arClerk",
          "template": {
            "customer": "${Customer[0].id}",
            "arAccount": "${Account[0].id}",
            "revenueAccount": "${Account[1].id}",
            "invoiceDate": "2026-09-01",
            "dueDate": "2026-09-30",
            "amountOutstanding": "120.0000",
            "lines": [
              {
                "description": "Widgets",
                "quantity": "1",
                "unitPrice": "120.0000"
              }
            ]
          },
          "expect": "ok"
        },
        {
          "op": "updateRecord",
          "entity": "Invoice",
          "asRole": "arClerk",
          "recordId": "${Invoice[0].id}",
          "template": {
            "version": "${Invoice[0].version}",
            "status": "SUBMITTED"
          },
          "expect": "ok"
        },
        {
          "op": "queryRecord",
          "entity": "Task",
          "asRole": "accountingManager",
          "template": {
            "filter": {
              "status": "OPEN"
            }
          },
          "expect": "ok"
        },
        {
          "op": "resolveTask",
          "entity": "Task",
          "asRole": "accountingManager",
          "recordId": "${Task[0].id}",
          "template": {
            "action": "approve",
            "comment": "approved"
          },
          "expect": "ok"
        },
        {
          "op": "createRecord",
          "entity": "CreditNote",
          "asRole": "arClerk",
          "template": {
            "customer": "${Customer[0].id}",
            "invoice": "${Invoice[0].id}",
            "noteDate": "2026-09-10",
            "currency": "USD",
            "amount": "20.0000",
            "reason": "Returned goods"
          },
          "expect": "ok"
        },
        {
          "op": "updateRecord",
          "entity": "Invoice",
          "asRole": "arClerk",
          "recordId": "${Invoice[0].id}",
          "template": {
            "version": "${Invoice[0].version}",
            "amountOutstanding": "100.0000"
          },
          "expect": "ok"
        },
        {
          "op": "runReport",
          "entity": "arAging",
          "asRole": "controller",
          "template": {},
          "expect": "ok"
        }
      ],
      "assertExpressions": [
        "${Invoice[0].status} == 'POSTED'",
        "${CreditNote[0].amount} == 20.0000",
        "${Invoice[0].amountOutstanding} == 100.0000",
        "${Report[0].totals.outstanding} == 100.0000"
      ]
    },
    {
      "name": "eur-invoice-posts-in-book-currency",
