{
  "apiName": "glLedgerEdges",
  "label": "GL edges — gapless numbering, balanced/one-side rules, machine transitions, reject→resubmit, stale versions, cascade delete, role walls, period machine",
  "cases": [
    {
      "name": "gapless-numbering-never-burns-or-gaps",
      "fixtures": [
        {
          "entity": "Account",
          "asRole": "accountingManager",
          "template": {
            "code": "1100",
            "name": "Accounts Receivable",
            "type": "ASSET"
          }
        },
        {
          "entity": "Account",
          "asRole": "accountingManager",
          "template": {
            "code": "4000",
            "name": "Sales Revenue",
            "type": "REVENUE"
          }
        },
        {
          "entity": "Customer",
          "asRole": "arClerk",
          "template": {
            "name": "Numbering Probe Co"
          }
        }
      ],
      "steps": [
        {
          "op": "createRecord",
          "entity": "JournalEntry",
          "asRole": "arClerk",
          "template": {
            "entryDate": "2026-09-01",
            "memo": "first entry of the tenant",
            "lines": [
              {
                "account": "${Account[0].id}",
                "debit": "40.0000"
              },
              {
                "account": "${Account[1].id}",
                "credit": "40.0000"
              }
            ]
          },
          "expect": "ok"
        },
        {
          "op": "createRecord",
          "entity": "JournalEntry",
          "asRole": "arClerk",
          "template": {
            "entryDate": "2026-09-01",
            "memo": "second entry",
            "lines": [
              {
                "account": "${Account[0].id}",
                "debit": "10.0000"
              },
              {
                "account": "${Account[1].id}",
                "credit": "10.0000"
              }
            ]
          },
          "expect": "ok"
        },
        {
          "op": "createRecord",
          "entity": "JournalEntry",
          "asRole": "arClerk",
          "template": {
            "entryDate": "2026-09-01",
            "memo": "unbalanced — must reject and burn no number",
            "lines": [
              {
                "account": "${Account[0].id}",
                "debit": "25.0000"
              },
              {
                "account": "${Account[1].id}",
                "credit": "20.0000"
              }
            ]
          },
          "expect": "validation(balanced)"
        },
        {
          "op": "createRecord",
          "entity": "JournalLine",
          "asRole": "arClerk",
          "template": {
            "entry": "${JournalEntry[0].id}",
            "account": "${Account[0].id}",
            "debit": "5.0000",
            "credit": "5.0000"
          },
          "expect": "validation(oneSideOnly)"
        },
        {
          "op": "createRecord",
          "entity": "JournalEntry",
          "asRole": "arClerk",
          "template": {
            "entryDate": "2026-09-02",
            "memo": "third entry — the failures drew nothing",
            "lines": [
              {
                "account": "${Account[0].id}",
                "debit": "7.0000"
              },
              {
                "account": "${Account[1].id}",
                "credit": "7.0000"
              }
            ]
          },
          "expect": "ok"
        },
        {
          "op": "createRecord",
          "entity": "Invoice",
          "asRole": "arClerk",
          "template": {
            "customer": "${Customer[0].id}",
            "arAccount": "${Account[0].id}",
            "revenueAccount": "${Account[1].id}",
            "invoiceDate": "2026-09-02",
            "dueDate": "2026-10-02",
            "amountOutstanding": "30.0000",
            "lines": [
              {
                "description": "Numbering probe",
                "quantity": "1",
                "unitPrice": "30.0000"
              }
            ]
          },
          "expect": "ok"
        },
        {
          "op": "createRecord",
          "entity": "CreditNote",
          "asRole": "arClerk",
          "template": {
            "customer": "${Customer[0].id}",
            "invoice": "${Invoice[0].id}",
            "noteDate": "2026-09-03",
            "amount": "5.0000",
            "reason": "numbering probe"
          },
          "expect": "ok"
        },
        {
          "op": "createRecord",
          "entity": "Payment",
          "asRole": "arClerk",
          "template": {
            "invoice": "${Invoice[0].id}",
            "customer": "${Customer[0].id}",
            "paymentDate": "2026-09-04",
            "amount": "5.0000"
          },
          "expect": "ok"
        }
      ],
      "assertExpressions": [
        "${JournalEntry[0].reference} == 'JE-000001'",
        "${JournalEntry[1].reference} == 'JE-000002'",
        "${JournalEntry[2].reference} == 'JE-000003'",
        "${Invoice[0].number} == 'INV-000001'",
        "${CreditNote[0].number} == 'CN-000001'",
        "${Payment[0].number} == 'PAY-00001'"
      ]
    },
    {
      "name": "rejected-journal-stays-open-resubmit-posts",
      "fixtures": [
        {
          "entity": "Account",
          "asRole": "accountingManager",
          "template": {
            "code": "1101",
            "name": "Accounts Receivable",
            "type": "ASSET"
          }
        },
        {
          "entity": "Account",
          "asRole": "accountingManager",
          "template": {
            "code": "4001",
            "name": "Sales Revenue",
            "type": "REVENUE"
          }
        }
      ],
      "steps": [
        {
          "op": "createRecord",
          "entity": "JournalEntry",
          "asRole": "arClerk",
          "template": {
            "entryDate": "2026-09-05",
            "memo": "wrong account on the credit side",
            "lines": [
              {
                "account": "${Account[0].id}",
                "debit": "20.0000"
              },
              {
                "account": "${Account[1].id}",
                "credit": "20.0000"
              }
            ]
          },
          "expect": "ok"
        },
        {
          "op": "updateRecord",
          "entity": "JournalEntry",
          "asRole": "arClerk",
          "recordId": "${JournalEntry[0].id}",
          "template": {
            "version": "${JournalEntry[0].version}",
            "status": "SUBMITTED"
          },
          "expect": "ok"
        },
        {
          "op": "queryRecord",
          "entity": "Task",
          "asRole": "accountingManager",
          "template": {
            "filter": {
              "status": "OPEN"
            }
          },
          "expect": "ok"
        },
        {
          "op": "resolveTask",
          "entity": "Task",
          "asRole": "accountingManager",
          "recordId": "${Task[0].id}",
          "template": {
            "action": "reject",
            "comment": "credit side is wrong — fix and resubmit"
          },
          "expect": "ok"
        },
        {
          "op": "queryRecord",
          "entity": "JournalEntry",
          "asRole": "arClerk",
          "template": {
            "filter": {
              "reference": "${JournalEntry[0].reference}"
            }
          },
          "expect": "ok"
        },
        {
          "op": "updateRecord",
          "entity": "JournalEntry",
          "asRole": "arClerk",
          "recordId": "${JournalEntry[0].id}",
          "template": {
            "version": "${JournalEntry[0].version}",
            "memo": "corrected memo — resubmit rides the SUBMITTED guard"
          },
          "expect": "ok"
        },
        {
          "op": "queryRecord",
          "entity": "Task",
          "asRole": "accountingManager",
          "template": {
            "filter": {
              "status": "OPEN"
            }
          },
          "expect": "ok"
        },
        {
          "op": "resolveTask",
          "entity": "Task",
          "asRole": "accountingManager",
          "recordId": "${Task[1].id}",
          "template": {
            "action": "approve",
            "comment": "correction approved"
          },
          "expect": "ok"
        }
      ],
      "assertExpressions": [
        "${JournalEntry[0].status} == 'POSTED'",
        "${JournalEntry[0].memo} == 'corrected memo — resubmit rides the SUBMITTED guard'",
        "${JournalEntry[0].totalDebit} == 20.0000"
      ]
    },
    {
      "name": "zero-total-entry-has-no-approval-to-fire",
      "fixtures": [
        {
          "entity": "Account",
          "asRole": "accountingManager",
          "template": {
            "code": "1102",
            "name": "Accounts Receivable",
            "type": "ASSET"
          }
        },
        {
          "entity": "Account",
          "asRole": "accountingManager",
          "template": {
            "code": "4002",
            "name": "Sales Revenue",
            "type": "REVENUE"
          }
        }
      ],
      "steps": [
        {
          "op": "createRecord",
          "entity": "JournalEntry",
          "asRole": "arClerk",
          "template": {
            "entryDate": "2026-09-06",
            "memo": "balanced at zero — the posting guard wants totalDebit > 0",
            "lines": [
              {
                "account": "${Account[0].id}",
                "debit": "0.0000"
              },
              {
                "account": "${Account[1].id}",
                "credit": "0.0000"
              }
            ]
          },
          "expect": "ok"
        },
        {
          "op": "updateRecord",
          "entity": "JournalEntry",
          "asRole": "arClerk",
          "recordId": "${JournalEntry[0].id}",
          "template": {
            "version": "${JournalEntry[0].version}",
            "status": "SUBMITTED"
          },
          "expect": "ok"
        },
        {
          "op": "queryRecord",
          "entity": "Task",
          "asRole": "accountingManager",
          "template": {
            "filter": {
              "status": "OPEN"
            }
          },
          "expect": "ok"
        }
      ],
      "assertExpressions": [
        "${JournalEntry[0].status} == 'SUBMITTED'",
        "${Query[0].count} == 0"
      ]
    },
    {
      "name": "state-machine-rejects-unlisted-jumps",
      "fixtures": [
        {
          "entity": "Account",
          "asRole": "accountingManager",
          "template": {
            "code": "1103",
            "name": "Accounts Receivable",
            "type": "ASSET"
          }
        },
        {
          "entity": "Account",
          "asRole": "accountingManager",
          "template": {
            "code": "4003",
            "name": "Sales Revenue",
            "type": "REVENUE"
          }
        }
      ],
      "steps": [
        {
          "op": "createRecord",
          "entity": "JournalEntry",
          "asRole": "arClerk",
          "template": {
            "entryDate": "2026-09-07",
            "memo": "draft entry",
            "lines": [
              {
                "account": "${Account[0].id}",
                "debit": "15.0000"
              },
              {
                "account": "${Account[1].id}",
                "credit": "15.0000"
              }
            ]
          },
          "expect": "ok"
        },
        {
          "op": "updateRecord",
          "entity": "JournalEntry",
          "asRole": "arClerk",
          "recordId": "${JournalEntry[0].id}",
          "template": {
            "version": "${JournalEntry[0].version}",
            "status": "POSTED"
          },
          "expect": "error(STATE_TRANSITION)"
        },
        {
          "op": "updateRecord",
          "entity": "JournalEntry",
          "asRole": "arClerk",
          "recordId": "${JournalEntry[0].id}",
          "template": {
            "version": "${JournalEntry[0].version}",
            "memo": "still draft — the jump was refused"
          },
          "expect": "ok"
        },
        {
          "op": "updateRecord",
          "entity": "JournalEntry",
          "asRole": "arClerk",
          "recordId": "${JournalEntry[0].id}",
          "template": {
            "version": "${JournalEntry[0].version}",
            "status": "SUBMITTED"
          },
          "expect": "ok"
        },
        {
          "op": "queryRecord",
          "entity": "Task",
          "asRole": "accountingManager",
          "template": {
            "filter": {
              "status": "OPEN"
            }
          },
          "expect": "ok"
        },
        {
          "op": "resolveTask",
          "entity": "Task",
          "asRole": "accountingManager",
          "recordId": "${Task[0].id}",
          "template": {
            "action": "approve"
          },
          "expect": "ok"
        }
      ],
      "assertExpressions": [
        "${JournalEntry[0].status} == 'POSTED'"
      ]
    },
    {
      "name": "stale-version-writes-and-deletes-lose-the-race",
      "fixtures": [
        {
          "entity": "Account",
          "asRole": "accountingManager",
          "template": {
            "code": "1104",
            "name": "Accounts Receivable",
            "type": "ASSET"
          }
        },
        {
          "entity": "Account",
          "asRole": "accountingManager",
          "template": {
            "code": "4004",
            "name": "Sales Revenue",
            "type": "REVENUE"
          }
        }
      ],
      "steps": [
        {
          "op": "createRecord",
          "entity": "JournalEntry",
          "asRole": "arClerk",
          "template": {
            "entryDate": "2026-09-08",
            "memo": "optimistic-lock probe",
            "lines": [
              {
                "account": "${Account[0].id}",
                "debit": "12.0000"
              },
              {
                "account": "${Account[1].id}",
                "credit": "12.0000"
              }
            ]
          },
          "expect": "ok"
        },
        {
          "op": "updateRecord",
          "entity": "JournalEntry",
          "asRole": "arClerk",
          "recordId": "${JournalEntry[0].id}",
          "template": {
            "version": "${JournalEntry[0].version}",
            "memo": "first edit wins"
          },
          "expect": "ok"
        },
        {
          "op": "updateRecord",
          "entity": "JournalEntry",
          "asRole": "arClerk",
          "recordId": "${JournalEntry[0].id}",
          "template": {
            "version": 1,
            "memo": "stale loser"
          },
          "expect": "error(CONFLICT_VERSION)"
        },
        {
          "op": "deleteRecord",
          "entity": "JournalEntry",
          "asRole": "accountingManager",
          "recordId": "${JournalEntry[0].id}",
          "template": {
            "version": 1
          },
          "expect": "error(CONFLICT_VERSION)"
        },
        {
          "op": "deleteRecord",
          "entity": "JournalEntry",
          "asRole": "accountingManager",
          "recordId": "${JournalEntry[0].id}",
          "template": {
            "version": "${JournalEntry[0].version}"
          },
          "expect": "ok"
        },
        {
          "op": "queryRecord",
          "entity": "JournalLine",
          "asRole": "accountingManager",
          "template": {
            "filter": {
              "entry": "${JournalEntry[0].id}"
            }
          },
          "expect": "ok"
        }
      ],
      "assertExpressions": [
        "${JournalEntry[0].memo} == 'first edit wins'",
        "${Query[0].count} == 0"
      ]
    },
    {
      "name": "role-walls-and-dangling-references",
      "fixtures": [
        {
          "entity": "Account",
          "asRole": "accountingManager",
          "template": {
            "code": "1105",
            "name": "Accounts Receivable",
            "type": "ASSET"
          }
        },
        {
          "entity": "Account",
          "asRole": "accountingManager",
          "template": {
            "code": "4005",
            "name": "Sales Revenue",
            "type": "REVENUE"
          }
        }
      ],
      "steps": [
        {
          "op": "createRecord",
          "entity": "Account",
          "asRole": "arClerk",
          "template": {
            "code": "9999",
            "name": "Chart-of-accounts write the clerk must not have",
            "type": "ASSET"
          },
          "expect": "error(FORBIDDEN)"
        },
        {
          "op": "createRecord",
          "entity": "JournalEntry",
          "asRole": "arClerk",
          "template": {
            "entryDate": "2026-09-09",
            "memo": "line points at an account that does not exist",
            "lines": [
              {
                "account": "12345678-90ab-cdef-1234-567890abcdef",
                "debit": "3.0000"
              },
              {
                "account": "${Account[1].id}",
                "credit": "3.0000"
              }
            ]
          },
          "expect": "error(VALIDATION_FAILED)"
        },
        {
          "op": "createRecord",
          "entity": "JournalEntry",
          "asRole": "arClerk",
          "template": {
            "memo": "entryDate is required — omitted"
          },
          "expect": "error(VALIDATION_FAILED)"
        },
        {
          "op": "createRecord",
          "entity": "JournalEntry",
          "asRole": "arClerk",
          "template": {
            "entryDate": "2026-09-09",
            "memo": "positive control",
            "lines": [
              {
                "account": "${Account[0].id}",
                "debit": "3.0000"
              },
              {
                "account": "${Account[1].id}",
                "credit": "3.0000"
              }
            ]
          },
          "expect": "ok"
        },
        {
          "op": "runReport",
          "entity": "trialBalance",
          "asRole": "arClerk",
          "template": {},
          "expect": "error(FORBIDDEN)"
        },
        {
          "op": "runReport",
          "entity": "trialBalance",
          "asRole": "controller",
          "template": {},
          "expect": "ok"
        }
      ],
      "assertExpressions": [
        "${Report[0].totals.debitTotal} == ${Report[0].totals.creditTotal}",
        "${Report[0].totals.debitTotal} == 95.0000"
      ]
    },
    {
      "name": "period-machine-admits-only-its-listed-edges",
      "fixtures": [
        {
          "entity": "Account",
          "asRole": "accountingManager",
          "template": {
            "code": "1106",
            "name": "Accounts Receivable",
            "type": "ASSET"
          }
        },
        {
          "entity": "Account",
          "asRole": "accountingManager",
          "template": {
            "code": "4006",
            "name": "Sales Revenue",
            "type": "REVENUE"
          }
        }
      ],
      "steps": [
        {
          "op": "createRecord",
          "entity": "AccountingPeriod",
          "asRole": "accountingManager",
          "template": {
            "name": "May 2026",
            "startDate": "2026-05-01",
            "endDate": "2026-05-31"
          },
          "expect": "ok"
        },
        {
          "op": "updateRecord",
          "entity": "AccountingPeriod",
          "asRole": "accountingManager",
          "recordId": "${AccountingPeriod[0].id}",
          "template": {
            "version": "${AccountingPeriod[0].version}",
            "status": "CLOSED"
          },
          "expect": "error(STATE_TRANSITION)"
        },
        {
          "op": "updateRecord",
          "entity": "AccountingPeriod",
          "asRole": "accountingManager",
          "recordId": "${AccountingPeriod[0].id}",
          "template": {
            "version": "${AccountingPeriod[0].version}",
            "status": "CLOSING"
          },
          "expect": "ok"
        },
        {
          "op": "updateRecord",
          "entity": "AccountingPeriod",
          "asRole": "accountingManager",
          "recordId": "${AccountingPeriod[0].id}",
          "template": {
            "version": "${AccountingPeriod[0].version}",
            "status": "OPEN"
          },
          "expect": "error(STATE_TRANSITION)"
        },
        {
          "op": "updateRecord",
          "entity": "AccountingPeriod",
          "asRole": "accountingManager",
          "recordId": "${AccountingPeriod[0].id}",
          "template": {
            "version": "${AccountingPeriod[0].version}",
            "status": "CLOSED"
          },
          "expect": "ok"
        },
        {
          "op": "updateRecord",
          "entity": "AccountingPeriod",
          "asRole": "accountingManager",
          "recordId": "${AccountingPeriod[0].id}",
          "template": {
            "version": "${AccountingPeriod[0].version}",
            "status": "OPEN"
          },
          "expect": "ok"
        },
        {
          "op": "createRecord",
          "entity": "JournalEntry",
          "asRole": "arClerk",
          "template": {
            "entryDate": "2026-05-10",
            "memo": "the reopened May period admits writes again",
            "lines": [
              {
                "account": "${Account[0].id}",
                "debit": "4.0000"
              },
              {
                "account": "${Account[1].id}",
                "credit": "4.0000"
              }
            ]
          },
          "expect": "ok"
        }
      ],
      "assertExpressions": [
        "${AccountingPeriod[0].status} == 'OPEN'"
      ]
    }
  ]
}
