          },
          "expect": "ok"
        },
        {
          "op": "queryRecord",
          "entity": "Task",
          "asRole": "accountingManager",
          "template": {
            "filter": {
              "status": "OPEN"
            }
          },
          "expect": "ok"
        },
        {
          "op": "resolveTask",
          "entity": "Task",
          "asRole": "accountingManager",
          "recordId": "${Task[0].id}",
          "template": {
            "action": "approve"
          },
          "expect": "ok"
        },
        {
          "op": "queryRecord",
          "entity": "JournalEntry",
          "asRole": "arClerk",
          "template": {
            "filter": {
              "sourceInvoice": "${Invoice[0].id}"
            }
          },
          "expect": "ok"
        },
        {
          "op": "updateRecord",
          "entity": "JournalEntry",
          "asRole": "arClerk",
          "recordId": "${JournalEntry[0].id}",
          "template": {
            "version": "${JournalEntry[0].version}",
            "status": "SUBMITTED"
          },
          "expect": "ok"
        },
        {
          "op": "queryRecord",
          "entity": "Task",
          "asRole": "accountingManager",
          "template": {
            "filter": {
              "status": "OPEN"
            }
          },
          "expect": "ok"
        },
        {
          "op": "resolveTask",
          "entity": "Task",
          "asRole": "accountingManager",
          "recordId": "${Task[1].id}",
          "template": {
            "action": "approve"
          },
          "expect": "ok"
        },
        {
          "op": "createRecord",
          "entity": "Payment",
          "asRole": "arClerk",
          "template": {
            "invoice": "${Invoice[0].id}",
            "customer": "${Customer[0].id}",
            "paymentDate": "2026-09-21",
            "amount": "80.0000"
          },
          "expect": "ok"
        },
        {
          "op": "updateRecord",
          "entity": "Invoice",
          "asRole": "arClerk",
          "recordId": "${Invoice[0].id}",
          "template": {
            "version": "${Invoice[0].version}",
            "amountOutstanding": "0.0000"
          },
          "expect": "ok"
        },
        {
          "op": "runReport",
          "entity": "arAging",
          "asRole": "controller",
          "template": {},
          "expect": "ok"
        }
      ],
      "assertExpressions": [
        "${Invoice[0].status} == 'POSTED'",
        "${Invoice[0].amountOutstanding} == 0.0000",
        "${Payment[0].amount} == ${Invoice[0].total}",
        "${Report[0].totals.outstanding} == 70.0000"
      ]
    }
  ]
}
