            "type": "ASSET"
          }
        },
        {
          "entity": "Account",
          "asRole": "accountingManager",
          "template": {
            "code": "4001",
            "name": "Sales Revenue",
            "type": "REVENUE"
          }
        },
        {
          "entity": "Customer",
          "asRole": "arClerk",
          "template": {
            "name": "Golden Harvest Foods"
          }
        }
      ],
      "steps": [
        {
          "op": "createRecord",
