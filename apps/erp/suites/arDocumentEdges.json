      "assertExpressions": [
        "${Invoice[0].status} == 'POSTED'",
        "${Payment[0].amount} == 120.0000",
        "${Invoice[0].amountOutstanding} == -20.0000",
        "${Report[0].totals.outstanding} == 285.0000"
      ]
    },
    {
      "name": "uniqueness-walls-and-missing-record",
      "label": "field-level uniqueness enforces; the declared composite unique (FxRate currency+rateDate) does not — G-16's honest pin",
      "fixtures": [
        {
          "entity": "Account",
          "asRole": "accountingManager",
          "template": {
            "code": "1300",
            "name": "Uniqueness Probe",
            "type": "ASSET"
          }
        }
      ],
      "steps": [
        {
          "op": "createRecord",
          "entity": "Account",
          "asRole": "accountingManager",
          "template": {
            "code": "1300",
            "name": "Duplicate code",
            "type": "ASSET"
          },
          "expect": "error(VALIDATION_FAILED)"
        },
        {
          "op": "createRecord",
          "entity": "FxRate",
          "asRole": "accountingManager",
          "template": {
            "currency": "EUR",
            "rateDate": "2026-09-01",
            "rate": "1.100000"
          },
          "expect": "ok"
        },
        {
          "op": "createRecord",
          "entity": "FxRate",
          "asRole": "accountingManager",
          "template": {
            "currency": "EUR",
            "rateDate": "2026-09-01",
            "rate": "1.200000"
          },
          "expect": "ok"
        },
        {
          "op": "createRecord",
          "entity": "Customer",
          "asRole": "arClerk",
          "template": {
            "email": "noname@probe.example"
          },
          "expect": "error(VALIDATION_FAILED)"
        },
        {
          "op": "createRecord",
          "entity": "Item",
          "asRole": "inventoryClerk",
          "template": {
            "sku": "DUP-SKU",
            "name": "Uniqueness Widget"
          },
          "expect": "ok"
        },
        {
          "op": "createRecord",
          "entity": "Item",
          "asRole": "inventoryClerk",
          "template": {
            "sku": "DUP-SKU",
            "name": "Second Widget, same sku"
          },
          "expect": "error(VALIDATION_FAILED)"
        },
        {
          "op": "updateRecord",
          "entity": "Account",
          "asRole": "accountingManager",
          "recordId": "8f8f8f8f-8f8f-8f8f-8f8f-8f8f8f8f8f8f",
          "template": {
            "version": 1,
            "name": "no such account"
          },
          "expect": "error(NOT_FOUND)"
        }
      ],
      "assertExpressions": [
        "${FxRate[0].rate} == 1.100000",
        "${FxRate[1].rate} == 1.200000",
        "${Item[0].sku} == 'DUP-SKU'"
      ]
    }
  ]
}
