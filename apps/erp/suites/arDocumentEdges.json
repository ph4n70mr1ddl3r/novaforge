        {
          "entity": "Account",
          "asRole": "accountingManager",
          "template": {
            "code": "1204",
            "name": "Accounts Receivable",
            "type": "ASSET"
          }
        },
        {
          "entity": "Account",
          "asRole": "accountingManager",
          "template": {
            "code": "4104",
            "name": "Sales Revenue",
            "type": "REVENUE"
          }
        },
        {
          "entity": "Customer",
          "asRole": "arClerk",
          "template": {
            "name": "Overpayer Inc"
          }
        }
      ],
      "steps": [
        {
          "op": "createRecord",
          "entity": "Invoice",
          "asRole": "arClerk",
          "template": {
            "customer": "${Customer[0].id}",
