  "gapLog": [
    {
      "id": "BR-G-1",
      "area": "P1/P8 Apps",
      "blocker": "Cross-app record creation: one app's flows cannot create records in another app's entities (createRecord resolves entities within the owning app), so the portfolio's P2P app cannot post its auto-journal into the Erp dogfood app's GL — every domain app must carry its own GL skeleton until an app-to-app primitive exists",
      "workaround": "Wave 1 ships a self-contained P2P app with its own minimal GL (Account/JournalEntry/JournalLine mirroring the proven Erp patterns); consolidation across domain GLs is out of scope until the primitive lands",
      "proposed": "cross-app createRecord (namespaced entity refs + target-app permission binding), or app-to-app event contracts consumed by flows",
      "priority": "high",
      "disposition": "backlog"
    },
    {
      "id": "BR-G-2",
      "area": "P3 Business Logic",
      "blocker": "Cross-document quantity guards and roll-ups: the 3-way match (bill qty <= receipt qty <= ordered qty) and the automatic receipt-side update of PurchaseOrderLine.qtyReceived need aggregate queries over lookup traversals (sum receipts by poLine) or writes to a bound record — the bind primitive reads a bound target's view but cannot write it, and report vocabulary cannot join lookups (the Erp G-12 twin)",
      "workaround": "Receipt carries denormalized po + poLine + item lookups (consistency by authoring discipline, pinned by the suites); PurchaseOrderLine.qtyReceived is clerk-maintained; over-receipt and bill-over-receipt mismatches ride the bill approval gate (procurementManager sees the documents) instead of a hard guard",
      "proposed": "an aggregate-query flow step over lookup paths (e.g. sumLookups), or write-back bindings on bind (bind + setField targeting the bound record), or lookup-path rollups",
      "priority": "high",
      "disposition": "backlog"
    },
    {
      "id": "BR-G-3",
      "area": "AP",
      "blocker": "Payment allocation across multiple bills: a payment split over several bills needs the Erp G-9 allocate primitive; wave 1 payments bind exactly one bill",
      "workaround": "One payment per bill (the dominant AP case for merchandise invoices); split payments are logged, not automated",
      "proposed": "the allocate primitive (payment → bills, FIFO or specific) shared with the Erp gap",
      "priority": "medium",
      "disposition": "backlog"
    },
    {
      "id": "BR-G-4",
      "area": "GL",
      "blocker": "Period lock: the P2P app's GL carries no AccountingPeriod/periodLock — dated-write control for bill journals rides the Erp app's proven periodLock harvest only after BR-G-1 (cross-app) or a shared GL lands",
      "workaround": "Bill journal dates are clerk-disciplined; the suite corpus pins current-period dates",
      "proposed": "adopt the periodLock block (entity/dateField/restrictedStatus/exemptField) once the GL home is settled",
      "priority": "medium",
      "disposition": "backlog"
    }
  ]
}
