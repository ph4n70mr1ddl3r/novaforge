{
  "apiName": "p2pReceivingBillingEdges",
  "label": "Receiving + billing edges — validation gates, terminal freeze, draft-vs-posted settlement, the BR-G-2 pins",
  "cases": [
    {
      "name": "receipt-validation-and-terminal-freeze-edges",
      "fixtures": [
        {
          "entity": "Item",
          "asRole": "receivingClerk",
          "template": {
            "sku": "SKU-BD-3001",
            "name": "Paint 1L",
            "uom": "EA"
          }
        },
        {
          "entity": "Vendor",
          "asRole": "buyer",
          "template": {
            "name": "Coatings Wholesale"
          }
        }
      ],
      "steps": [
        {
          "op": "createRecord",
          "entity": "PurchaseOrder",
          "asRole": "buyer",
          "template": {
            "vendor": "${Vendor[0].id}",
            "orderDate": "2026-09-07",
            "status": "DRAFT",
            "lines": [
              {
                "item": "${Item[0].id}",
                "qty": 10,
                "unitPrice": "25.0000"
              }
            ]
          },
          "expect": "ok"
        },
        {
          "op": "queryRecord",
          "entity": "PurchaseOrderLine",
          "asRole": "buyer",
          "template": {
            "filter": {
              "field": "po",
              "op": "eq",
              "value": "${PurchaseOrder[0].id}"
            }
          },
          "expect": "ok"
        },
        {
          "op": "createRecord",
          "entity": "GoodsReceipt",
          "asRole": "receivingClerk",
          "template": {
            "po": "${PurchaseOrder[0].id}",
            "poLine": "${PurchaseOrderLine[0].id}",
            "item": "${Item[0].id}",
            "receiptDate": "2026-09-08",
            "qty": -5,
            "status": "DRAFT"
          },
          "expect": "validation(receiptPositive)"
        },
        {
          "op": "createRecord",
          "entity": "GoodsReceipt",
          "asRole": "receivingClerk",
          "template": {
            "po": "${PurchaseOrder[0].id}",
            "poLine": "${PurchaseOrderLine[0].id}",
            "item": "${Item[0].id}",
            "receiptDate": "2026-09-08",
            "qty": 10,
            "status": "DRAFT"
          },
          "expect": "ok"
        },
        {
          "op": "updateRecord",
          "entity": "GoodsReceipt",
          "asRole": "receivingClerk",
          "recordId": "${GoodsReceipt[0].id}",
          "template": {
            "version": "${GoodsReceipt[0].version}",
            "status": "POSTED"
          },
          "expect": "validation(receiptPriced)"
        },
        {
          "op": "updateRecord",
          "entity": "GoodsReceipt",
          "asRole": "receivingClerk",
          "recordId": "${GoodsReceipt[0].id}",
          "template": {
            "version": "${GoodsReceipt[0].version}",
            "unitCost": "25.0000",
            "status": "POSTED"
          },
          "expect": "ok"
        },
        {
          "op": "updateRecord",
          "entity": "GoodsReceipt",
          "asRole": "receivingClerk",
          "recordId": "${GoodsReceipt[0].id}",
          "template": {
            "version": "${GoodsReceipt[0].version}",
            "qty": 11
          },
          "expect": "error(RECORD_FROZEN)"
        },
        {
          "op": "deleteRecord",
          "entity": "GoodsReceipt",
          "asRole": "procurementManager",
          "recordId": "${GoodsReceipt[0].id}",
          "template": {
            "version": "${GoodsReceipt[0].version}"
          },
          "expect": "error(RECORD_FROZEN)"
        }
      ],
      "assertExpressions": [
        "${GoodsReceipt[0].value} == 250.0000",
        "${Item[0].qtyReceived} == 10"
      ]
    },
    {
      "name": "bill-validation-and-settlement-edges-including-the-overpay-pin",
      "fixtures": [
        {
          "entity": "Account",
          "asRole": "procurementManager",
          "template": {
            "code": "2101",
            "name": "AP Control",
            "type": "LIABILITY"
          }
        },
        {
          "entity": "Account",
          "asRole": "procurementManager",
          "template": {
            "code": "6101",
            "name": "Store Expense",
            "type": "EXPENSE"
          }
        },
        {
          "entity": "Item",
          "asRole": "receivingClerk",
          "template": {
            "sku": "SKU-BD-3002",
            "name": "Garden Hose 20m",
            "uom": "EA"
          }
        },
        {
          "entity": "Vendor",
          "asRole": "buyer",
          "template": {
            "name": "GardenLine Traders"
          }
        }
      ],
      "steps": [
        {
          "op": "createRecord",
          "entity": "PurchaseOrder",
          "asRole": "buyer",
          "template": {
            "vendor": "${Vendor[0].id}",
            "orderDate": "2026-09-07",
            "status": "DRAFT",
            "lines": [
              {
                "item": "${Item[0].id}",
                "qty": 10,
                "unitPrice": "25.0000"
              }
            ]
          },
          "expect": "ok"
        },
        {
          "op": "updateRecord",
          "entity": "PurchaseOrder",
          "asRole": "buyer",
          "recordId": "${PurchaseOrder[0].id}",
          "template": {
            "version": "${PurchaseOrder[0].version}",
            "status": "SUBMITTED"
          },
          "expect": "ok"
        },
        {
          "op": "queryRecord",
          "entity": "PurchaseOrderLine",
          "asRole": "buyer",
          "template": {
            "filter": {
              "field": "po",
              "op": "eq",
              "value": "${PurchaseOrder[0].id}"
            }
          },
          "expect": "ok"
        },
        {
          "op": "createRecord",
          "entity": "VendorBill",
          "asRole": "apClerk",
          "template": {
            "vendor": "${Vendor[0].id}",
            "po": "${PurchaseOrder[0].id}",
            "billDate": "2026-09-08",
            "dueDate": "2026-09-01",
            "apAccount": "${Account[0].id}",
            "expenseAccount": "${Account[1].id}",
            "status": "DRAFT",
            "lines": [
              {
                "poLine": "${PurchaseOrderLine[0].id}",
                "item": "${Item[0].id}",
                "quantity": 10,
                "unitPrice": "25.0000"
              }
            ]
          },
          "expect": "validation(dueNotBeforeBill)"
        },
        {
          "op": "createRecord",
          "entity": "VendorBill",
          "asRole": "apClerk",
          "template": {
            "vendor": "${Vendor[0].id}",
            "po": "${PurchaseOrder[0].id}",
            "billDate": "2026-09-08",
            "dueDate": "2026-10-08",
            "apAccount": "${Account[0].id}",
            "expenseAccount": "${Account[1].id}",
            "status": "DRAFT",
            "lines": [
              {
                "poLine": "${PurchaseOrderLine[0].id}",
                "item": "${Item[0].id}",
                "quantity": 10,
                "unitPrice": "25.0000"
              }
            ]
          },
          "expect": "ok"
        },
        {
          "op": "updateRecord",
          "entity": "VendorBill",
          "asRole": "apClerk",
          "recordId": "${VendorBill[0].id}",
          "template": {
            "version": "${VendorBill[0].version}",
            "status": "SUBMITTED"
          },
          "expect": "ok"
        },
        {
          "op": "queryRecord",
          "entity": "Task",
          "asRole": "procurementManager",
          "template": {
            "filter": {
              "status": "OPEN"
            }
          },
          "expect": "ok"
        },
        {
          "op": "resolveTask",
          "entity": "Task",
          "asRole": "procurementManager",
          "recordId": "${Task[0].id}",
          "template": {
            "action": "approve"
          },
          "expect": "ok"
        },
        {
          "op": "createRecord",
          "entity": "BillPayment",
          "asRole": "apClerk",
          "template": {
            "bill": "${VendorBill[0].id}",
            "paymentDate": "2026-09-20",
            "amount": "0.0000",
            "status": "DRAFT"
          },
          "expect": "validation(positiveAmount)"
        },
        {
          "op": "createRecord",
          "entity": "BillPayment",
          "asRole": "apClerk",
          "template": {
            "bill": "${VendorBill[0].id}",
            "paymentDate": "2026-09-20",
            "amount": "250.0000",
            "status": "DRAFT"
          },
          "expect": "ok"
        },
        {
          "op": "queryRecord",
          "entity": "VendorBill",
          "asRole": "apClerk",
          "template": {
            "filter": {
              "field": "number",
              "op": "eq",
              "value": "${VendorBill[0].number}"
            }
          },
          "expect": "ok"
        },
        {
          "op": "updateRecord",
          "entity": "BillPayment",
          "asRole": "apClerk",
          "recordId": "${BillPayment[0].id}",
          "template": {
            "version": "${BillPayment[0].version}",
            "status": "POSTED"
          },
          "expect": "ok"
        },
        {
          "op": "deleteRecord",
          "entity": "BillPayment",
          "asRole": "apClerk",
          "recordId": "${BillPayment[0].id}",
          "template": {
            "version": "${BillPayment[0].version}"
          },
          "expect": "error(RECORD_FROZEN)"
        }
      ],
      "assertExpressions": [
        "${VendorBill[0].status} == 'POSTED'",
        "${VendorBill[0].amountPaid} == 250.0000",
        "${VendorBill[0].amountOutstanding} == 0.0000"
      ]
    },
    {
      "name": "draft-payment-does-not-settle-and-the-br-g-2-overpay-pin",
