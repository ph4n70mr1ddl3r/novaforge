            "type": "EXPENSE"
          }
        },
        {
          "entity": "Item",
          "asRole": "receivingClerk",
          "template": {
            "sku": "SKU-BD-3003",
            "name": "Work Gloves",
            "uom": "PK"
          }
        },
        {
          "entity": "Vendor",
          "asRole": "buyer",
          "template": {
            "name": "SafetyGear Direct"
