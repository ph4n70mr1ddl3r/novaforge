<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>com.novaforge</groupId>
  <artifactId>novaforge-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>NovaForge Parent</name>
  <description>Metadata-driven no-code application platform — root parent + aggregator</description>

  <properties>
    <!-- XLSX export (reporting §6) — the one third-party lib outside the BOM imports;
         centralized here like every other version (PHASE-0 §4.1). -->
    <poi.version>5.4.1</poi.version>
    <jib.version>3.5.2</jib.version>
    <java.version>21</java.version>
    <spring-cloud.version>2025.1.2</spring-cloud.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- ArchUnit rules start in Phase 1 (PHASE-0 §10) -->
    <archunit.version>1.4.1</archunit.version>
    <!-- GraalVM polyglot for the Script Engine sandbox (ADR-003) -->
    <graalvm.version>24.2.1</graalvm.version>
    <!-- Flowable 8 = the Spring Framework 7 / Boot 4 line of the engine (ADR-004
         amended: Flowable 7.2 does not run on Boot 4; 8.0.0 is the same engine on
         the pinned stack). -->
    <flowable.version>8.0.0</flowable.version>
    <!-- Outbound call resilience (PHASE-6 §3) — Resilience4j 2.x on Java 21. -->
    <resilience4j.version>2.2.0</resilience4j.version>
    <!-- MinIO client (PHASE-6 §8) — presigned URLs against compose MinIO / S3. -->
    <minio.version>8.5.17</minio.version>
    <!-- OpenAPI 3 per service (PLAN.md §4 / PHASE-1 §4): the springdoc 3.x line is
         the Spring Framework 7 / Boot 4 port of the starter. -->
    <springdoc.version>3.1.0</springdoc.version>
  </properties>

  <modules>
    <module>platform</module>
    <module>services</module>
    <!-- Last: the e2e cycles boot the services from their packaged jars, so the whole
         reactor must be built first. -->
    <module>e2e-tests</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.apache.poi</groupId>
        <artifactId>poi-ooxml</artifactId>
        <version>${poi.version}</version>
      </dependency>
      <!-- Internal libs: service POMs never carry versions (PHASE-0 §4.1). -->
      <dependency>
        <groupId>com.novaforge</groupId>
        <artifactId>novaforge-common-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.novaforge</groupId>
        <artifactId>novaforge-metadata-model</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.novaforge</groupId>
        <artifactId>novaforge-security-context</artifactId>
        <version>${project.version}</version>
      </dependency>
      <!-- No novaforge-event-schemas entry: the PHASE-0 §5.4 charter was resolved
           in place at the Phase 3 review — spine contracts live in-producer, shared
           header constants in security-context (PHASE-3 §4); extract a contracts lib
           only when a second typed cross-service consumer appears.
      -->
      <dependency>
        <groupId>com.novaforge</groupId>
        <artifactId>novaforge-expression-dsl</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.novaforge</groupId>
        <artifactId>novaforge-test-support</artifactId>
        <version>${project.version}</version>
      </dependency>
      <!-- GraalJS on a stock JVM — the community jars (ADR-003). The
           org.graalvm.polyglot:js-community coordinate is a pom-packaging
           aggregator with no jar; the service depends on the concrete
           artifacts it aggregates. -->
      <dependency>
        <groupId>org.graalvm.polyglot</groupId>
        <artifactId>polyglot</artifactId>
        <version>${graalvm.version}</version>
      </dependency>
      <dependency>
        <groupId>org.graalvm.js</groupId>
        <artifactId>js-language</artifactId>
        <version>${graalvm.version}</version>
      </dependency>
      <dependency>
        <groupId>org.graalvm.regex</groupId>
        <artifactId>regex</artifactId>
        <version>${graalvm.version}</version>
      </dependency>
      <dependency>
        <groupId>io.opentelemetry</groupId>
        <artifactId>opentelemetry-exporter-otlp</artifactId>
        <version>${opentelemetry.version}</version>
      </dependency>
      <!-- Embedded BPMN engine in the Workflow Service (ADR-004, PHASE-4 §9). -->
      <dependency>
        <groupId>org.flowable</groupId>
        <artifactId>flowable-spring-boot-starter-process</artifactId>
        <version>${flowable.version}</version>
      </dependency>
      <!-- Outbound resilience for the Integration Service's connector executor
           (PHASE-6 §3): circuit breakers + bounded retries with exponential backoff. -->
      <dependency>
        <groupId>io.github.resilience4j</groupId>
        <artifactId>resilience4j-circuitbreaker</artifactId>
        <version>${resilience4j.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.resilience4j</groupId>
        <artifactId>resilience4j-retry</artifactId>
        <version>${resilience4j.version}</version>
      </dependency>
      <dependency>
        <groupId>io.minio</groupId>
        <artifactId>minio</artifactId>
        <version>${minio.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <build>
    <pluginManagement>
      <plugins>
        <!-- Jib for every service image (PHASE-0 §5) — the version pinned once here;
             service POMs keep only their per-image <to> configuration. -->
        <plugin>
          <groupId>com.google.cloud.tools</groupId>
          <artifactId>jib-maven-plugin</artifactId>
          <version>${jib.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
